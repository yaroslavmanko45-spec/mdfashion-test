# Тестовые данные, которые вводятся в поля ввода на md-fashion.ua.
# Значения с пробелами в начале/конце и со спецсимволами — в кавычках.

# --- Поиск: основные запросы ---
SEARCH_QUERY_DRESS=сукня
SEARCH_QUERY_PARTIAL=сук
SEARCH_QUERY_SKU=WW0WW46138
SEARCH_QUERY_SKU_LOWER=ww0ww46138

# --- Поиск: регистр и пробелы ---
SEARCH_QUERY_DRESS_UPPER=СУКНЯ
SEARCH_QUERY_DRESS_SPACES="  сукня  "
SEARCH_QUERY_DRESS_BLACK_SPACES="сукня   чорна"
SEARCH_QUERY_SPACES_ONLY="   "

# --- Поиск: без результатов ---
SEARCH_QUERY_NO_RESULTS=ффффыыыы12345

# --- Поиск: спецсимволы и длинная строка ---
SEARCH_QUERY_XSS="<script>alert(1)</script>"
SEARCH_QUERY_SQL_INJECTION='" OR 1=1 --'
SEARCH_QUERY_PERCENT=%
SEARCH_QUERY_SPECIAL_CHARS="&&??//"
SEARCH_QUERY_EMOJI=😀
SEARCH_QUERY_LONG_CHAR=а
SEARCH_QUERY_LONG_LENGTH=1000

# --- Поиск: языки и бренд ---
SEARCH_QUERY_RU=платье
SEARCH_QUERY_BRAND="Tommy Hilfiger"
SEARCH_QUERY_BRAND_LOWER="tommy hilfiger"
SEARCH_QUERY_BRAND_CYRILLIC=томмі

# --- Корзина: промокод ---
PROMO_CODE_INVALID=TEST000
